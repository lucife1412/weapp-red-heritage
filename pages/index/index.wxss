/* pages/index/index.wxss */
.home-page {
  position: relative;
}

.banner {
  width: 100%;
  height: 440rpx;
}

.banner image {
  width: 100%;
  height: 100%;
}

/* 功能卡片 */
.card {
  position: absolute;
  top: 400rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 60rpx 60rpx 0 0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.card-banner {
  width: calc(100% - 40rpx);
  height: 180rpx;
  margin: 10rpx 0 20rpx;
  padding: 20rpx;
}

.card-banner image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

/* 功能图标区 */
.function-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 60rpx;
  padding: 0 40rpx;
}

.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 22%;
  font-size: 28rpx;
}

.func-item image {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 16rpx;
}

/* 文物推荐 */
.section-header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  color: #000;
  font-weight: bold;
  padding: 0 30rpx;
}

.relic-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.img-content {
  position: relative;
  margin-right: 30rpx;
}

.play-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  z-index: 2;
}

.relic-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.relic-info {
  flex: 1;
}

.relic-title {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.relic-address {
  font-size: 26rpx;
  color: #666;
}

.detail-btn {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  color: #d42323;
  font-size: 28rpx;
}