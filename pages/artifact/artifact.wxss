/* pages/artifact/artifact.wxss */
/* Banner */
.banner {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 400rpx;
}

.bg-banner {
	position: absolute;
	top: 0;
	left: 0;
	background: rgb(148, 56, 55, 0.8);
	width: 100%;
	height: 400rpx;
}

.bg-text {
	position: absolute;
	top: 60rpx;
	left: 20rpx;
	font-size: 40rpx;
	color: #fff;
}

.bg-text1 {
	position: absolute;
	top: 130rpx;
	left: 20rpx;
	color: #fff;
}

/* 瀑布流布局 */
.waterfall {
	position: absolute;
	top: 400rpx;
	left: 0;
	padding: 20rpx;
	column-count: 2;
	column-gap: 20rpx;
}

.item {
	break-inside: avoid;
	background: white;
	border-radius: 16rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.item-img {
	width: 100%;
	height: 300rpx;
	border-radius: 16rpx 16rpx 0 0;
}

.item-title {
	display: block;
	padding: 20rpx;
	font-size: 30rpx;
	color: #333;
}

.detail-btn {
	padding: 0 20rpx 20rpx;
	text-align: right;
	color: #d42323;
	font-size: 26rpx;
}