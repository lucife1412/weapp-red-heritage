/* pages/map/map.wxss */
.map-container {
	height: 100vh;
	position: relative;
}

.search-bar {
	position: absolute;
	top: 20rpx;
	left: 30rpx;
	right: 30rpx;
	z-index: 99;
	display: flex;
	background: rgba(255, 255, 255, 0.9);
	border-radius: 50rpx;
	padding: 16rpx 30rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.search-input {
	flex: 1;
	font-size: 28rpx;
	color: #333;
}

.search-icon {
	width: 36rpx;
	height: 32rpx;
	margin-left: 20rpx;
	padding-top: 8rpx;
}

.filter-bar {
	position: absolute;
	top: 120rpx;
	left: 30rpx;
	z-index: 99;
	background: rgba(255, 255, 255, 0.9);
	border-radius: 40rpx;
	padding: 12rpx;
}

.filter-item {
	display: inline-block;
	padding: 12rpx 24rpx;
	margin: 0 8rpx;
	border-radius: 32rpx;
	font-size: 24rpx;
	color: #666;
	background: #f5f5f5;
}

.filter-item.active {
	background: #d42323;
	color: white;
}

.map-content {
	width: 100%;
	height: 100vh;
}