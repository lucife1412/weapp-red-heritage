<!--pages/route/route.wxml-->
<view class="route">
  <!-- Banner -->
  <!-- <image class="banner" src="/images/04.png" mode="aspectFill" /> -->

  <!-- 推荐卡片 -->
  <view class="card">
    <!-- 标题 -->
    <view class="card-header">
      <text class="title">红色线路推荐</text>
    </view>

    <!-- 导航图标 -->
    <view class="nav-grid" bind:tap="navigateDetail" data-id="{{item.id}}" wx:for="{{list}}" wx:key="id">
      <image src="{{item.image}}" class="nav-icon" mode="aspectFill" />
      <view class="flex-box">
        <view class="nav-text">{{item.title}}</view>
        <view class="go-to">
          <text>前往</text>
          <image src="https://weapp-red-heritage.oss-cn-wuhan-lr.aliyuncs.com/images/right-icon.png" class="right-icon" />
        </view>
      </view>
    </view>
  </view>
</view>