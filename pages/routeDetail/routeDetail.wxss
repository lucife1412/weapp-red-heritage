/* pages/routeDetail/routeDetail.wxss */
.route-detail {
  background: rgb(254, 250, 248);
  min-height: 100vh;
}

.banner {
  width: 100%;
  height: 400rpx;
}

.route-card {
  padding: 30rpx;
}

.title {
  font-size: 36rpx;
  color: #000;
  font-weight: bold;
}

.route-intro {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 地址卡片 */
.address-item {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  padding: 0;
}

/* 左侧图片 */
.item-image {
  width: 280rpx;
  height: 240rpx;
  border-radius: 16rpx 0 0 16rpx;
  flex-shrink: 0;
}

/* 右侧内容 */
.item-content {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 标题样式 */
.item-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

/* 地址样式 */
.item-address {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 导航按钮 */
.nav-btn {
  position: absolute;
  right: 24rpx;
  bottom: 15rpx;
  color: #A23F39;
  font-size: 28rpx;
}